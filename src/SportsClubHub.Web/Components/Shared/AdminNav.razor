            </div>
        </Authorized>
    </AuthorizeView>

    <NavLink href="admin" Match="NavLinkMatch.All">Dashboard</NavLink>
    <NavLink href="admin/tasks">Tasks</NavLink>

    <p class="admin-nav-heading">Directory</p>
    <NavLink href="admin/sports">Sports</NavLink>
    <NavLink href="admin/clubs">Clubs and teams</NavLink>
    <NavLink href="admin/venues">Venues</NavLink>

    <p class="admin-nav-heading">Engagement</p>
    <NavLink href="admin/announcements">Announcements</NavLink>
    <NavLink href="admin/competitions">Competitions</NavLink>

    <AuthorizeView Roles="@AppRoles.Administrator">
        <p class="admin-nav-heading">System</p>
        <NavLink href="admin/accounts">Staff accounts</NavLink>
        <NavLink href="admin/site">Home page hero</NavLink>
    </AuthorizeView>

    <div class="admin-nav-footer">
        <a href="/">View public site</a>
        <a href="account/logout">Sign out</a>
