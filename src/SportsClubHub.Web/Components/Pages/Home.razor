@page "/"
@inject InsightsService InsightsService
@inject AnnouncementService AnnouncementService

<PageTitle>Sports Club Hub | Find a sport, club or venue near you</PageTitle>

<section class="home-hero">
    <div class="container home-hero-grid">
        <div class="hero-copy">
            <p class="eyebrow eyebrow-light">South Africa's community sports directory</p>
            <h1>Find your sport. Find your people. <em>Play locally.</em></h1>
            <p class="hero-intro">Discover sports, connect with clubs and find places to play in your community. Whether you are picking up a racket or returning to the field, your next game starts nearby.</p>
            <div class="hero-actions">
                <a class="btn btn-gold btn-lg" href="sports">Explore sports <span aria-hidden="true">↗</span></a>
                <a class="text-link-light" href="clubs/register">Register a club or team <span aria-hidden="true">→</span></a>
            </div>
        </div>
        <div class="hero-art" aria-label="A selection of sports represented in the community" role="img">
            <div class="hero-art-label">Play locally<br /><strong>Live fully.</strong></div>
            <div class="sport-tile sport-tile-large"><span>01</span><strong>Field<br />sports</strong></div>
            <div class="sport-tile sport-tile-small"><span>02</span><strong>Water<br />sports</strong></div>
            <div class="hero-line"></div>
        </div>
    </div>
</section>

<div class="container">
    <section class="section home-intro">
        <div>
            <p class="eyebrow">Start somewhere</p>
            <h2>There is more than one way into the game.</h2>
        </div>
        <p class="intro-copy">Our directory connects residents with the people, places and sports that make local communities move. Explore at your own pace, then take the next step.</p>
    </section>

    @if (counts is not null && (counts.VerifiedClubs + counts.ActiveSports + counts.ActiveVenues) > 0)
    {
        <section class="directory-stats" aria-label="Directory size">
            <div class="stat-feature"><span class="stat-number">@counts.ActiveSports</span><span class="stat-label">sports to explore</span></div>
            <div><span class="stat-number">@counts.VerifiedClubs</span><span class="stat-label">verified clubs</span></div>
            <div><span class="stat-number">@counts.ActiveVenues</span><span class="stat-label">places to play</span></div>
            <a class="stat-cta" href="insights">See the community picture <span aria-hidden="true">↗</span></a>
        </section>
    }

    <section class="section home-paths">
        <a class="feature-path feature-path-green" href="sports">
            <span class="feature-index">01 / Explore</span>
            <h2>Find a sport that fits your life.</h2>
            <p>From football and netball to chess and surfing, browse the sports active in your community.</p>
            <span class="feature-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="feature-path feature-path-paper" href="clubs">
            <span class="feature-index">02 / Connect</span>
            <h2>Meet the clubs making it happen.</h2>
            <p>Search by sport or location and find a welcoming club near you.</p>
            <span class="feature-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="feature-path feature-path-gold" href="get-involved">
            <span class="feature-index">03 / Join in</span>
            <h2>Make your interest count.</h2>
            <p>Tell us what you would like to play so local opportunities can grow.</p>
            <span class="feature-arrow" aria-hidden="true">↗</span>
        </a>
    </section>

    <section class="home-bottom-banner">
        <div>
            <p class="eyebrow eyebrow-light">For clubs and organisers</p>
            <h2>Put your club on the map.</h2>
        </div>
        <a class="btn btn-outline-light-strong" href="clubs/register">Register a club <span aria-hidden="true">↗</span></a>
    </section>

    @if (announcements is not null && announcements.Count > 0)
    {
        <section class="section" aria-labelledby="latest-announcements">
            <p class="eyebrow">From the community</p>
            <h2 id="latest-announcements">Latest announcements</h2>
            <div class="row g-3">
                @foreach (var announcement in announcements.Take(3))
                {
                    <article class="col-md-4">
                        <div class="item-card">
                            <span class="tag">@announcement.Category</span>
                            <h3>@announcement.Title</h3>
                            <p class="mb-0">@announcement.Message</p>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>

@code {
    private DirectoryCounts? counts;
    private List<Announcement>? announcements;

    protected override async Task OnInitializedAsync()
    {
        counts = await InsightsService.GetDirectoryCountsAsync();
        announcements = await AnnouncementService.GetPublishedAsync();
    }
}
