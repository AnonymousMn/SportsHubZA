@page "/sports"
@rendermode InteractiveNoPrerender
@inject SportService SportService
@inject IJSRuntime JS

<PageTitle>Sports | Sports Club Hub</PageTitle>

<div class="container">
    <PageHeader Title="Sports" Subtitle="Browse the sports available in your community, then find clubs and venues for them." />

    @if (all is not null && courtSlides.Count > 0)
    {
        <CourtCarousel Slides="courtSlides" OnSelect="OpenQuickLook" />
    }

    <div class="browse-toolbar">
        <div class="browse-search">
            <label class="form-label" for="sport-search">Search by name</label>
            <input id="sport-search" class="form-control" type="search" placeholder="For example: netball"
                   @bind="search" @bind:event="oninput" />
        </div>
        <div class="browse-options">
            <div class="form-check form-switch">
                <input id="only-clubs" class="form-check-input" type="checkbox" role="switch" @bind="onlyWithClubs" />
                <label class="form-check-label" for="only-clubs">Only sports with clubs</label>
            </div>
            <div class="view-toggle" role="group" aria-label="Layout">
                <button type="button" class="view-btn @(listView ? "" : "active")" aria-pressed="@(listView ? "false" : "true")" @onclick="() => listView = false">Grid</button>
                <button type="button" class="view-btn @(listView ? "active" : "")" aria-pressed="@(listView ? "true" : "false")" @onclick="() => listView = true">List</button>
            </div>
        </div>
    </div>

    @if (all is null)
    {
        <p class="muted" role="status">Loading sports...</p>
        <div class="sport-results" aria-hidden="true">
            @for (var i = 0; i < 6; i++)
            {
                <div class="sport-skeleton"><div class="skeleton-art"></div><div class="skeleton-line"></div><div class="skeleton-line short"></div></div>
            }
        </div>
    }
    else
    {
        var shown = SportBrowseFilter.Apply(all, search, category, onlyWithClubs);
        var counts = SportBrowseFilter.CategoryCounts(all, search, onlyWithClubs);

        <div class="category-rail" role="group" aria-label="Filter by category">
            <button type="button" class="chip @(category is null ? "active" : "")" aria-pressed="@(category is null ? "true" : "false")" @onclick="() => category = null">
                All <span class="chip-count">@counts.Values.Sum()</span>
            </button>
            @foreach (var option in Enum.GetValues<SportCategory>())
            {
                var count = counts.GetValueOrDefault(option);
                var selectedChip = category == option;
                <button type="button" class="chip @(selectedChip ? "active" : "")" aria-pressed="@(selectedChip ? "true" : "false")"
                        disabled="@(count == 0 && !selectedChip)" @onclick="() => category = option">
                    <span class="chip-dot chip-dot-@option.ToString().ToLowerInvariant()" aria-hidden="true"></span>
                    @option.ToDisplayText() <span class="chip-count">@count</span>
                </button>
            }
        </div>

        @if (shown.Count == 0)
        {
            <div class="panel">
                <p>No sports match your filters.</p>
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ClearFilters">Clear filters</button>
            </div>
        }
        else
        {
            <p class="muted" role="status" aria-live="polite">@shown.Count @(shown.Count == 1 ? "sport" : "sports") found</p>
            <div class="sport-results @(listView ? "is-list" : "")">
                @for (var index = 0; index < shown.Count; index++)
                {
                    var item = shown[index];
                    <article class="item-card sport-card sport-card-@item.Sport.Category.ToString().ToLowerInvariant()" style="--i:@index">
                            <div class="sport-card-art" aria-hidden="true">
                            @if (SportImages.Resolve(item.Sport) is { } photo)
                            {
                                <img class="sport-card-image" src="@photo" alt="" loading="lazy" onerror="this.style.display='none'" />
                            }
                            <span class="sport-card-initial">@item.Sport.Name[0]</span>
                        </div>
                        <div class="sport-card-body">
                            <div>
                                <span class="tag">@item.Sport.Category.ToDisplayText()</span>
                                <h2><a href="sports/@item.Sport.SportId">@item.Sport.Name</a></h2>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.Sport.Description))
                            {
                                <p class="sport-card-description mb-0">@item.Sport.Description</p>
                            }
                            <p class="meta mt-auto mb-0">
                                <span class="status-dot @(item.ClubCount > 0 ? "has-clubs" : "")" aria-hidden="true"></span>
                                @ClubText(item.ClubCount)
                            </p>
                            <div class="sport-card-actions">
                                <button type="button" id="quick-@item.Sport.SportId" class="btn btn-sm btn-outline-primary"
                                        aria-label="Quick look at @item.Sport.Name" @onclick="() => OpenQuickLook(item)">Quick look</button>
                                <a class="btn btn-sm btn-link" href="sports/@item.Sport.SportId">Full details</a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    }
</div>

@if (selected is not null)
{
    <div class="drawer-backdrop" @onclick="CloseQuickLook"></div>
    <aside class="sport-drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title" @onkeydown="OnDrawerKeyDown">
        <div class="drawer-header">
            <div>
                <span class="tag">@selected.Sport.Category.ToDisplayText()</span>
                <h2 id="drawer-title">@selected.Sport.Name</h2>
            </div>
            <button type="button" class="btn-close" aria-label="Close quick look" @ref="closeButton" @onclick="CloseQuickLook"></button>
        </div>
        @if (!string.IsNullOrWhiteSpace(selected.Sport.Description))
        {
            <p>@selected.Sport.Description</p>
        }
        <dl class="drawer-facts">
            <div><dt>Verified clubs</dt><dd>@selected.ClubCount</dd></div>
            @if (!string.IsNullOrWhiteSpace(selected.Sport.TypicalFacilityType))
            {
                <div><dt>Typically played on</dt><dd>@selected.Sport.TypicalFacilityType</dd></div>
            }
        </dl>
        @if (selected.ClubCount == 0)
        {
            <p class="notice">No verified clubs offer this yet. Registering your interest helps show where new clubs are needed.</p>
        }
        <div class="drawer-actions">
            <a class="btn btn-primary" href="get-involved?sport=@selected.Sport.SportId">I'm interested</a>
            <a class="btn btn-outline-primary" href="sports/@selected.Sport.SportId">See clubs and venues</a>
        </div>
    </aside>
}

@code {
    private string search = string.Empty;
    private SportCategory? category;
    private bool onlyWithClubs;
    private bool listView;
    private List<SportListItem>? all;
    private SportListItem? selected;
    private ElementReference closeButton;
    private List<SportListItem> courtSlides = new();
    private bool focusDrawer;

    private static string ClubText(int count) =>
        count == 0 ? "No verified clubs yet" : count == 1 ? "1 verified club" : $"{count} verified clubs";

    protected override async Task OnInitializedAsync()
    {
        all = await SportService.SearchAsync(null, null);
        courtSlides = all.Where(i => i.Sport.Category == SportCategory.CourtSport).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusDrawer)
        {
            focusDrawer = false;
            await closeButton.FocusAsync();
        }
    }

    private void ClearFilters()
    {
        search = string.Empty;
        category = null;
        onlyWithClubs = false;
    }

    private void OpenQuickLook(SportListItem item)
    {
        selected = item;
        focusDrawer = true;
    }

    private async Task CloseQuickLook()
    {
        var id = selected?.Sport.SportId;
        selected = null;
        if (id is not null)
        {
            // Give keyboard users their place back in the list.
            await JS.InvokeVoidAsync("sportsClubHub.focusById", $"quick-{id}");
        }
    }

    private async Task OnDrawerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseQuickLook();
        }
    }
}
