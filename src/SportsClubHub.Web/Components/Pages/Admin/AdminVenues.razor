@page "/admin/venues"
@attribute [Authorize(Roles = AppRoles.Administrator + "," + AppRoles.Staff)]
@rendermode InteractiveNoPrerender
@inject VenueService VenueService
@inject SportService SportService
@using Microsoft.AspNetCore.Components.Forms

<div class="container">
    <PageHeader Title="Manage venues" Subtitle="Add or edit venues and choose which sports each one supports." />
    <AdminNav />

    @if (message is not null)
    {
        <div class="alert alert-success" role="status">@message</div>
    }

    <section class="panel import-panel mb-4" aria-labelledby="venue-import-heading">
        <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
            <div>
                <p class="eyebrow mb-1">Bulk import</p>
                <h2 id="venue-import-heading">Import venues from files</h2>
                <p class="muted mb-0">Upload one or more CSV or TXT files. Nothing is saved until you review and confirm the preview.</p>
            </div>
            <a class="btn btn-outline-primary" href="data:text/csv;charset=utf-8,Name%2CLocation%2CAddress%2CVenueType%2CSurfaceType%2CCapacity%2CSports%0ABaywest%20Ground%2CNelson%20Mandela%20Bay%2C%2CField%2CNatural%20grass%2C2500%2CFootball%3BHockey" download="venue-import-template.csv">Download template</a>
        </div>
        <div class="mt-3">
            <label class="form-label" for="venue-import-files">CSV or TXT files</label>
            <InputFile id="venue-import-files" OnChange="PreviewFilesAsync" multiple accept=".csv,.txt,text/csv,text/plain" />
            <div class="form-text">Columns: Name, Location, Address, VenueType, SurfaceType, Capacity, Sports. Separate multiple sports with semicolons.</div>
        </div>
        @if (importError is not null)
        {
            <div class="alert alert-danger mt-3" role="alert">@importError</div>
        }
        @if (importRows.Count > 0)
        {
            <div class="table-scroll mt-3">
                <table class="data import-table">
                    <thead><tr><th>File / row</th><th>Venue</th><th>Sports</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var row in importRows)
                        {
                            <tr>
                                <td>@row.SourceFile, @row.RowNumber</td>
                                <td>@(row.Venue?.Name ?? "—")</td>
                                <td>@(row.SportNames.Count == 0 ? "—" : string.Join(", ", row.SportNames))</td>
                                <td>
                                    @if (row.Error is null)
                                    {
                                        <span class="tag">Ready to import</span>
                                    }
                                    else
                                    {
                                        <span class="tag tag-bad">@row.Error</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="button" class="btn btn-primary" disabled="@(!CanImport)" @onclick="ImportAsync">Import @ValidImportCount valid venues</button>
                <button type="button" class="btn btn-link" @onclick="ClearImport">Clear preview</button>
            </div>
        }
    </section>

    <div class="row g-4">
        <div class="col-lg-6">
            @if (venues is null)
            {
                <p class="muted" role="status">Loading...</p>
            }
            else if (venues.Count == 0)
            {
                <div class="panel"><p class="mb-0">No venues yet. Add the first one using the form.</p></div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="data">
                        <thead><tr><th scope="col">Venue</th><th scope="col">Sports</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                        <tbody>
                            @foreach (var venue in venues)
                            {
                                <tr class="@(venue.IsActive ? "" : "text-muted")">
                                    <td>
                                        <strong>@venue.Name</strong>@(venue.IsActive ? "" : " (inactive)")<br />
                                        <span class="muted">@venue.Location, @venue.VenueType.ToDisplayText()</span>
                                    </td>
                                    <td>@string.Join(", ", venue.VenueSports.Select(vs => vs.Sport.Name).OrderBy(n => n))</td>
                                    <td class="text-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Edit(venue)">Edit</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleActiveAsync(venue)">@(venue.IsActive ? "Deactivate" : "Activate")</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="col-lg-6">
            <div class="panel">
                <h2>@(editing.VenueId == 0 ? "Add a venue" : "Edit venue")</h2>
                <EditForm Model="editing" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    @if (errorMessage is not null)
                    {
                        <div class="alert alert-danger" role="alert">@errorMessage</div>
                    }
                    <div class="mb-3">
                        <label class="form-label" for="venue-name">Venue name</label>
                        <InputText id="venue-name" class="form-control" @bind-Value="editing.Name" />
                        <ValidationMessage For="() => editing.Name" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="venue-location-edit">Town or area</label>
                            <InputText id="venue-location-edit" class="form-control" @bind-Value="editing.Location" />
                            <ValidationMessage For="() => editing.Location" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="venue-type">Venue type</label>
                            <InputSelect id="venue-type" class="form-select" @bind-Value="editing.VenueType">
                                @foreach (var type in Enum.GetValues<VenueType>())
                                {
                                    <option value="@type">@type.ToDisplayText()</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="venue-address">Address</label>
                        <InputText id="venue-address" class="form-control" @bind-Value="editing.Address" />
                        <ValidationMessage For="() => editing.Address" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="venue-surface">Surface</label>
                            <InputText id="venue-surface" class="form-control" @bind-Value="editing.SurfaceType" />
                            <ValidationMessage For="() => editing.SurfaceType" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="venue-capacity">Capacity</label>
                            <InputNumber id="venue-capacity" class="form-control" @bind-Value="editing.Capacity" />
                            <ValidationMessage For="() => editing.Capacity" />
                        </div>
                    </div>

                    <p class="form-label mb-1">Sports supported</p>
                    <SportCheckboxes Sports="sports" Selected="selectedSportIds" IdPrefix="venue-sport" />

                    <button type="submit" class="btn btn-primary">Save venue</button>
                    @if (editing.VenueId != 0)
                    {
                        <button type="button" class="btn btn-link" @onclick="CancelEdit">Cancel</button>
                    }
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Venue>? venues;
    private List<Sport> sports = new();
    private Venue editing = new();
    private readonly HashSet<int> selectedSportIds = new();
    private string? message;
    private string? errorMessage;
    private string? importError;
    private List<VenueImportRow> importRows = new();

    protected override async Task OnInitializedAsync()
    {
        sports = await SportService.GetActiveAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => venues = await VenueService.SearchAsync(null, null, includeInactive: true);

    private void Edit(Venue venue)
    {
        editing = new Venue
        {
            VenueId = venue.VenueId,
            Name = venue.Name,
            Location = venue.Location,
            Address = venue.Address,
            VenueType = venue.VenueType,
            SurfaceType = venue.SurfaceType,
            Capacity = venue.Capacity,
            IsActive = venue.IsActive
        };
        selectedSportIds.Clear();
        foreach (var venueSport in venue.VenueSports)
        {
            selectedSportIds.Add(venueSport.SportId);
        }

        message = null;
        errorMessage = null;
    }

    private void CancelEdit()
    {
        editing = new Venue();
        selectedSportIds.Clear();
        errorMessage = null;
    }

    private async Task SaveAsync()
    {
        var wasNew = editing.VenueId == 0;
        var result = await VenueService.SaveAsync(editing, selectedSportIds.ToList());
        if (result.Succeeded)
        {
            message = wasNew ? "Venue added." : "Venue updated.";
            errorMessage = null;
            editing = new Venue();
            selectedSportIds.Clear();
            await LoadAsync();
        }
        else
        {
            errorMessage = result.Error;
        }
    }

    private async Task ToggleActiveAsync(Venue venue)
    {
        var result = await VenueService.SetActiveAsync(venue.VenueId, !venue.IsActive);
        message = result.Succeeded ? (venue.IsActive ? "Venue deactivated." : "Venue activated.") : null;
        errorMessage = result.Error;
        await LoadAsync();
    }

    private bool CanImport => ValidImportCount > 0;
    private int ValidImportCount => importRows.Count(row => row.Error is null && row.Venue is not null);

    private async Task PreviewFilesAsync(InputFileChangeEventArgs args)
    {
        importError = null;
        importRows.Clear();
        var files = new List<(string FileName, string Content)>();

        foreach (var file in args.GetMultipleFiles(50))
        {
            if (file.Size > 1_000_000)
            {
                importError = $"{file.Name} is larger than the 1 MB limit.";
                return;
            }

            await using var stream = file.OpenReadStream(1_000_000);
            using var reader = new StreamReader(stream);
            files.Add((file.Name, await reader.ReadToEndAsync()));
        }

        importRows = await VenueService.PreviewImportAsync(files);
        if (importRows.Count == 0)
        {
            importError = "No data rows were found in the selected files.";
        }
    }

    private async Task ImportAsync()
    {
        importError = null;
        var result = await VenueService.ImportAsync(importRows);
        if (!result.Succeeded)
        {
            importError = result.Error;
            return;
        }

        message = $"{ValidImportCount} venues imported.";
        importRows.Clear();
        await LoadAsync();
    }

    private void ClearImport()
    {
        importRows.Clear();
        importError = null;
    }
}
