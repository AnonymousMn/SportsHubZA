@page "/not-found"

<PageTitle>404 | Sports Club Hub</PageTitle>

<div class="not-found-page">
    <div class="container">
        <div class="not-found-content">
            <div class="not-found-copy">
                <p class="eyebrow">Referee's call: 404</p>
                <h1>That page is out of bounds.</h1>
                <p class="lead">
                    Foul called! This page has travelled beyond the playing area and cannot be found.
                    We will not be adding it to the scorecard.
                </p>
                <div class="not-found-actions">
                    <a class="btn btn-primary" href="/">Back to the home page</a>
                    <a class="btn btn-outline-primary" href="/clubs">Browse the club directory</a>
                </div>
            </div>

            <div class="sports-animation" aria-hidden="true">
                <div class="volleyball-scene">
                    <span class="volleyball"></span>
                    <span class="volleyball-net"></span>
                    <span class="volleyball-floor"></span>
                </div>
                <div class="basketball-scene">
                    <span class="basketball-hoop"></span>
                    <span class="basketball-backboard"></span>
                    <span class="basketball"></span>
                    <span class="basketball-floor"></span>
                </div>
            </div>
        </div>
    </div>
</div>
