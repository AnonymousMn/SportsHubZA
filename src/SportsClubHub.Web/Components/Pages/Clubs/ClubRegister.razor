@page "/clubs/register"
@rendermode InteractiveNoPrerender
@inject ClubService ClubService
@inject SportService SportService

<div class="container">
    <PageHeader Title="Register your club"
                Subtitle="Add your club to the directory. An administrator checks every new club before it is listed publicly." />

    @if (submitted)
    {
        <div class="panel col-lg-8" role="status">
            <h2>Thank you</h2>
            <p>Your club has been received and is waiting for verification. It will appear in the directory once an administrator approves it.</p>
            <a class="btn btn-primary" href="clubs">Back to the club directory</a>
        </div>
    }
    else
    {
        <EditForm Model="club" OnValidSubmit="SubmitAsync" class="col-lg-8">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-errors" />

            @if (errorMessage is not null)
            {
                <div class="alert alert-danger" role="alert">@errorMessage</div>
            }

            <div class="mb-3">
                <label class="form-label" for="club-name">Club name <span class="required-mark" aria-hidden="true">*</span></label>
                <InputText id="club-name" class="form-control" @bind-Value="club.Name" />
                <ValidationMessage For="() => club.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="club-location">Town or area <span class="required-mark" aria-hidden="true">*</span></label>
                <InputText id="club-location" class="form-control" @bind-Value="club.Location" />
                <ValidationMessage For="() => club.Location" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="club-description">About the club</label>
                <InputTextArea id="club-description" class="form-control" rows="3" @bind-Value="club.Description" />
                <ValidationMessage For="() => club.Description" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="club-email">Club e-mail <span class="required-mark" aria-hidden="true">*</span></label>
                    <InputText id="club-email" class="form-control" type="email" @bind-Value="club.ContactEmail" />
                    <ValidationMessage For="() => club.ContactEmail" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" for="club-phone">Club phone</label>
                    <InputText id="club-phone" class="form-control" type="tel" @bind-Value="club.ContactPhone" />
                    <ValidationMessage For="() => club.ContactPhone" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="club-website">Website</label>
                <InputText id="club-website" class="form-control" placeholder="https://" @bind-Value="club.Website" />
                <ValidationMessage For="() => club.Website" />
            </div>

            <p class="form-label mb-1">Sports your club offers <span class="required-mark" aria-hidden="true">*</span></p>
            <SportCheckboxes Sports="sports" Selected="selectedSportIds" IdPrefix="register-sport" />

            <p class="muted">Use the club's own contact details, not a private individual's.</p>

            <button type="submit" class="btn btn-primary" disabled="@saving">@(saving ? "Sending..." : "Register club")</button>
        </EditForm>
    }
</div>

@code {
    private Club club = new();
    private List<Sport> sports = new();
    private readonly HashSet<int> selectedSportIds = new();
    private bool saving;
    private bool submitted;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        sports = await SportService.GetActiveAsync();
    }

    private async Task SubmitAsync()
    {
        saving = true;
        errorMessage = null;

        var result = await ClubService.RegisterAsync(club, selectedSportIds.ToList());
        if (result.Succeeded)
        {
            submitted = true;
        }
        else
        {
            errorMessage = result.Error;
        }

        saving = false;
    }
}
