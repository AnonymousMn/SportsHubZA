# Copy this file to .env and replace the placeholders with local values.
# ASP.NET Core reads these names when they are exported as environment variables.

# The current app uses EF Core SQLite. Do not put the MongoDB URI in this setting
# until the data layer has been migrated to a MongoDB provider.
ConnectionStrings__DefaultConnection=Data Source=App_Data/sportsclubhub.db

# MongoDB Atlas URI reserved for the future MongoDB data-layer migration.
MONGODB_URI=mongodb+srv://thamsanqamnyakeni33_db_user:<db_password>@sporthub.suwhz0e.mongodb.net/

# Optional Gmail SMTP notifications. Use a Google App Password, never your normal password.
Email__Enabled=false
Email__Host=smtp.gmail.com
Email__Port=587
Email__TimeoutSeconds=15
Email__Username=your-gmail-address@gmail.com
Email__Password=your-google-app-password
Email__FromAddress=your-gmail-address@gmail.com
Email__FromName=Sports Club Hub SA

Admin__InitialEmail=<admin_email>
Admin__InitialPassword=<admin_password>
Database__LoadDemoData=false
